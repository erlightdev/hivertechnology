# Used when the site is served as static files (dist/client) by Hostinger's LiteSpeed/Apache.
# Mirrors server.mjs: canonical host, HTTPS, legacy redirects, caching and security headers.
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# www -> apex, http -> https (one hop)
RewriteCond %{HTTP_HOST} ^www\.hiver\.com\.np$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://hiver.com.np/$1 [R=301,L,NE]

# Legacy WordPress URLs (see astro.config.mjs and docs/DEPLOYMENT.md)
RewriteRule ^team/?$ /about-us/ [R=301,L]
RewriteRule ^category/blog/?$ /insights/ [R=301,L]
RewriteRule ^revolutionizing-software-solutions-hiver-technology-leading-the-way-in-nepal/?$ /about-us/ [R=301,L]

# Trailing slash for page routes (not files)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !(\.[a-zA-Z0-9]+|/)$
RewriteRule ^(.*)$ /$1/ [R=301,L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  <FilesMatch "\.(js|css|woff2|webp|avif|png|jpg|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>
