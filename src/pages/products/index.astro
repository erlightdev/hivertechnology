---
import { ArrowRight } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/common/PageHero.astro';
import ButtonLink from '@/components/common/ButtonLink.astro';
import Section from '@/components/common/Section.astro';
import CtaBand from '@/components/common/CtaBand.astro';
import { pageMeta } from '@/config/pages';
import { products } from '@/data/products';
import { breadcrumbs, graph, webPage } from '@/lib/schema';

const meta = pageMeta('/products/');
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Products', path: '/products/' },
];
const jsonLd = graph(webPage(meta.path, meta.title, meta.description), breadcrumbs(crumbs));

const serializedProducts = JSON.stringify(
  products.map((p, idx) => ({
    item_id: p.slug,
    item_name: p.name,
    item_category: p.label,
    index: idx + 1,
  }))
);
---

<BaseLayout {...meta} {jsonLd}>
  <PageHero
    {crumbs}
    eyebrow="Products"
    title="Products built for a specific operational need."
    intro="Configurable platforms for schools, clinics, dental practices and HR teams. Each is set up around your workflow, with training and a written support agreement."
  >
    <ButtonLink href="/contact/" arrow>Request a walkthrough</ButtonLink>
  </PageHero>

  <Section>
    <div class="grid gap-4 md:grid-cols-2">
      {
        products.map((p) => {
          const Icon = p.icon;
          return (
            <a
              href={`/products/${p.slug}/`}
              data-product-slug={p.slug}
              data-product-name={p.name}
              data-product-category={p.label}
              class="reveal group flex flex-col rounded-[6px] bg-base-default shadow-drop-sm ring-1 ring-border-secondary ring-inset dark:bg-background-secondary p-8 transition-shadow duration-200 ease-out-soft hover:shadow-drop-md"
            >
              <div class="flex items-center justify-between">
                <span class="grid size-11 place-items-center rounded-[6px] bg-base-default shadow-drop-sm ring-1 ring-border-secondary ring-inset">
                  <Icon className="size-5" aria-hidden="true" />
                </span>
                <span class="eyebrow">{p.label}</span>
              </div>
              <h2 class="mt-10 text-2xl font-medium">{p.name}</h2>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-foreground-tertiary">{p.summary}</p>
              <p class="mt-4 text-xs text-foreground-tertiary">For: {p.audience}</p>
              <span class="mt-6 inline-flex items-center gap-1.5 text-sm font-medium">
                View modules <ArrowRight className="size-4 transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
              </span>
            </a>
          );
        })
      }
    </div>
  </Section>

  <CtaBand
    title="See a product with your own workflow in mind."
    body="Book a walkthrough. We will show the modules that matter to you and be clear about what needs configuration or custom work."
    cta="Request a walkthrough"
  />

  <div id="products-catalog-data" class="hidden" data-products={serializedProducts} aria-hidden="true"></div>
  <script>
    import { trackViewItemList } from '@/lib/analytics';
    const el = document.getElementById('products-catalog-data');
    if (el?.dataset.products) {
      try {
        const items = JSON.parse(el.dataset.products);
        trackViewItemList({ items });
      } catch {}
    }
  </script>
</BaseLayout>
