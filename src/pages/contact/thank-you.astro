---
import { CircleCheck } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ButtonLink from '@/components/common/ButtonLink.astro';
import { pageMeta } from '@/config/pages';
import { site } from '@/config/site';

const meta = pageMeta('/contact/thank-you/');
---

<BaseLayout {...meta}>
  <section class="container-page flex min-h-[60vh] flex-col items-center justify-center py-24 text-center">
    <CircleCheck className="size-10 text-brand-base" aria-hidden="true" />
    <h1 class="mt-6 text-4xl font-medium">Enquiry received.</h1>
    <p class="mt-4 max-w-md text-lg text-foreground-tertiary">
      Thank you. An engineering lead will reply within {site.responseTime}. If it is urgent, call
      <a href={site.phoneHref} class="text-foreground-primary underline underline-offset-4">{site.phone}</a>.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <ButtonLink href="/" variant="secondary">Back to home</ButtonLink>
      <ButtonLink href="/insights/" arrow>Read our insights</ButtonLink>
    </div>
  </section>
</BaseLayout>
