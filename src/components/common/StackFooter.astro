---
/** Card footer: small stack logos + names on the left, a "Details" cue on the right. */
import { Image } from 'astro:assets';
import { ArrowUpRight } from 'lucide-react';
import { techByName } from '@/data/company';

export interface Props {
  stack?: string[];
  fallback?: string;
  label?: string;
}
const { stack = [], fallback, label = 'Details' } = Astro.props;
const logos = stack.map(techByName).filter((t) => t !== undefined).slice(0, 4);
const text = stack.length ? stack.slice(0, 4).join(', ') : fallback;
---

<div class="mt-5 flex items-center justify-between gap-3 border-t border-border-line pt-4">
  <span class="flex min-w-0 items-center gap-2">
    {
      logos.length > 0 && (
        <span class="flex shrink-0 items-center gap-1" aria-hidden="true">
          {logos.map((t) => (
            <>
              <Image src={t.logo} alt="" width={16} height={16} class:list={['size-4 object-contain', t.logoDark && 'dark:hidden']} />
              {t.logoDark && <Image src={t.logoDark} alt="" width={16} height={16} class="hidden size-4 object-contain dark:block" />}
            </>
          ))}
        </span>
      )
    }
    {text && <span class="truncate text-xs text-foreground-tertiary">{text}</span>}
  </span>
  <span class="inline-flex shrink-0 items-center gap-1 text-[13px] font-medium text-foreground-primary">
    {label}
    <ArrowUpRight className="size-3.5 transition-transform duration-200 ease-out-soft group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" />
  </span>
</div>
