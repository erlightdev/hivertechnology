---
/**
 * Problem → visual → prevention cards. Each micro-illustration is decorative
 * (hidden from assistive tech); the text carries the meaning.
 */
import { Briefcase, Check, Code2, Headset, User } from 'lucide-react';
import Section from '@/components/common/Section.astro';
import { problems } from '@/data/company';

const relay = [
  { icon: User, label: 'You' },
  { icon: Headset, label: 'Sales' },
  { icon: Briefcase, label: 'Manager' },
  { icon: Code2, label: 'Developer' },
];
---

<Section
  id="problem"
  eyebrow="The problem"
  title="Why software projects go wrong"
  titleMuted="and how we prevent it."
  intro="Three common problems — and the simple rule we follow to avoid each one."
>
  <ol class="grid gap-3 md:grid-cols-3">
    {
      problems.map((p, i) => (
        <li class="reveal group relative flex flex-col overflow-hidden rounded-[6px] bg-base-default shadow-drop-sm dark:bg-background-secondary">
          {/* Micro visual */}
          <div class="relative h-36 overflow-hidden border-b border-border-line bg-background-secondary" aria-hidden="true">
            <div class="bg-dots absolute inset-0 opacity-70 [mask-image:radial-gradient(ellipse_80%_80%_at_50%_40%,#000_30%,transparent_85%)]" />

            {p.id === 'scope' && (
              <div class="relative flex h-full flex-col justify-center gap-3 px-5">
                <div class="grid grid-cols-[4rem_1fr] items-center gap-3 font-paper text-[10px] text-foreground-tertiary">
                  <span>Planned</span>
                  <span class="relative h-2.5 rounded-full bg-background-tertiary/70 dark:bg-border-secondary">
                    <span class="absolute inset-y-0 left-0 w-[44%] rounded-full bg-foreground-muted/60" />
                  </span>
                </div>
                <div class="grid grid-cols-[4rem_1fr] items-center gap-3 font-paper text-[10px] text-foreground-tertiary">
                  <span>Actual</span>
                  <span class="relative h-2.5 rounded-full bg-background-tertiary/70 dark:bg-border-secondary">
                    <span class="overrun absolute inset-y-0 left-0 w-[96%] rounded-full bg-[linear-gradient(90deg,var(--foreground-muted)_0_46%,var(--error)_46%)] opacity-80" />
                  </span>
                </div>
                <div class="flex justify-between pl-[4.75rem] font-paper text-[10px]">
                  <span class="text-foreground-tertiary">week 4</span>
                  <span class="rounded-full bg-error/10 px-1.5 text-error">week 9 · over twice as long</span>
                </div>
              </div>
            )}

            {p.id === 'code' && (
              <div class="relative flex h-full items-center px-5">
                <div class="w-full rounded-[6px] bg-base-default p-3 font-paper text-[10px]/[1.6] shadow-drop-sm ring-1 ring-border-primary ring-inset dark:bg-background-primary">
                  <p class="text-foreground-tertiary"><span class="text-brand-base">function</span> deploy() {'{'}</p>
                  <p class="pl-3 text-foreground-tertiary">db.alter(<span class="text-foreground-secondary">'orders'</span>)</p>
                  <p class="pl-3 text-foreground-tertiary">ship()</p>
                  <p class="text-foreground-tertiary">{'}'}</p>
                  <div class="mt-2 flex flex-wrap gap-1">
                    {['not tested', 'no notes', 'risky to change'].map((t) => (
                      <span class="rounded-full bg-error/10 px-1.5 text-error">✕ {t}</span>
                    ))}
                  </div>
                </div>
              </div>
            )}

            {p.id === 'relay' && (
              <div class="relative flex h-full items-center justify-center px-4">
                {relay.map((r, ri) => {
                  const RIcon = r.icon;
                  return (
                    <>
                      <span class="flex flex-col items-center gap-1.5">
                        <span
                          class:list={[
                            'grid size-9 place-items-center rounded-full ring-1 ring-inset',
                            ri === 0 || ri === relay.length - 1
                              ? 'bg-base-default text-foreground-primary ring-border-secondary dark:bg-background-primary'
                              : 'bg-background-tertiary/60 text-foreground-muted ring-border-primary dark:bg-border-secondary',
                          ]}
                        >
                          <RIcon className="size-4" />
                        </span>
                        <span class="font-paper text-[10px] text-foreground-tertiary">{r.label}</span>
                      </span>
                      {ri < relay.length - 1 && (
                        <span class="relay-dash mx-1 mb-5 h-px w-6 border-t border-dashed border-border-tertiary sm:w-8" style={`--i:${ri}`} />
                      )}
                    </>
                  );
                })}
                <span class="absolute top-4 right-4 rounded-full bg-error/10 px-1.5 font-paper text-[10px] text-error">2 people in between</span>
              </div>
            )}
          </div>

          {/* Copy */}
          <div class="flex flex-1 flex-col p-5 lg:p-6">
            <p class="eyebrow">Problem 0{i + 1}</p>
            <h3 class="mt-2 text-[17px] font-medium tracking-[-0.3px]">{p.title}</h3>
            <p class="mt-2 flex-1 text-sm/6 text-foreground-secondary">{p.body}</p>
            <p class="mt-5 flex gap-2.5 border-t border-border-line pt-4 text-sm/6 text-foreground-primary">
              <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-honey text-base-black">
                <Check className="size-3" strokeWidth={3} aria-hidden="true" />
              </span>
              <span><span class="sr-only">How we prevent it: </span>{p.fix}</span>
            </p>
          </div>

          <span class="pointer-events-none absolute inset-0 rounded-[6px] ring-1 ring-border-secondary ring-inset" aria-hidden="true" />
        </li>
      ))
    }
  </ol>
</Section>

<style>
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .overrun {
        animation: overrun linear both;
        animation-timeline: view();
        animation-range: entry 10% entry 80%;
      }
    }
    .relay-dash {
      animation: relay 1.8s var(--ease-in-out-smooth) infinite;
      animation-delay: calc(var(--i) * 300ms);
    }
  }
  @keyframes overrun {
    from { width: 44%; }
    to { width: 96%; }
  }
  @keyframes relay {
    0%, 100% { opacity: 0.35; }
    50% { opacity: 1; }
  }
</style>
