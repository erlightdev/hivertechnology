---
/**
 * Generic page body for copy-deck pages (services and industries):
 * hero → buyer problem → approach + what's included → steps → FAQ → related → CTA.
 */
import { ArrowUpRight, Check, Minus } from 'lucide-react';
import PageHero from '@/components/common/PageHero.astro';
import ButtonLink from '@/components/common/ButtonLink.astro';
import Section from '@/components/common/Section.astro';
import Faq from '@/components/common/Faq.astro';
import CtaBand from '@/components/common/CtaBand.astro';
import type { DeckPage, DeckSection } from '@/data/deck';
import { ctaLabel } from '@/data/deck';
import type { Crumb } from '@/lib/schema';
import { relatedCards, secondaryHref } from '@/lib/links';

export interface Props {
  page: DeckPage;
  crumbs: Crumb[];
  problems?: DeckSection[];
  goodFit?: string[];
  notFit?: string[];
  stack?: string[];
  /** Extra related paths appended to the deck's list (e.g. products for an industry). */
  extraRelated?: string[];
}

const { page, crumbs, problems, goodFit, notFit, stack, extraRelated = [] } = Astro.props;
const primary = ctaLabel(page.primaryCta || 'Discuss your project');
const secondary = page.secondaryCta ? ctaLabel(page.secondaryCta) : undefined;
const related = relatedCards([...extraRelated, ...page.related], page.path).slice(0, 6);
const hasAside = Boolean(goodFit?.length || notFit?.length || stack?.length);
---

<PageHero {crumbs} eyebrow={page.eyebrow} title={page.h1} intro={page.intro}>
  <ButtonLink href="/contact/" arrow data-cta-location="hero">{primary}</ButtonLink>
  {secondary && <ButtonLink href={secondaryHref(page.secondaryCta)} variant="secondary" data-cta-location="hero">{secondary}</ButtonLink>}
</PageHero>

{
  page.problem && (
    <Section id="problem" eyebrow="The problem" title={page.problem.heading} intro={page.problem.body}>
      {problems && problems.length > 0 && (
        <ol class="grid overflow-hidden rounded-[6px] ring-1 ring-border-secondary ring-inset md:grid-cols-3">
          {problems.map((p, i) => (
            <li class="reveal space-y-3 border-border-secondary p-7 not-first:border-t md:not-first:border-t-0 md:not-first:border-l">
              <span class="font-paper text-xs text-foreground-muted">0{i + 1}</span>
              <h3 class="text-[17px] font-medium tracking-[-0.3px]">{p.heading}</h3>
              <p class="text-sm/6 text-foreground-secondary">{p.body}</p>
            </li>
          ))}
        </ol>
      )}
    </Section>
  )
}

<Section id="included" eyebrow="Our approach" title={page.approach?.heading ?? 'What is included'} intro={page.approach?.body}>
  <div class:list={['grid gap-10', hasAside && 'lg:grid-cols-[1.4fr_1fr]']}>
    <div>
      <h3 class="eyebrow mb-4">What is included</h3>
      <ul class:list={['grid gap-3', !hasAside && 'md:grid-cols-2']}>
        {
          page.included.map((item) => (
            <li class="reveal flex gap-3 rounded-[6px] bg-base-default p-5 text-sm/6 shadow-drop-sm ring-1 ring-border-secondary ring-inset dark:bg-background-secondary">
              <Check className="mt-0.5 size-4 shrink-0 text-brand-base" aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
    {
      hasAside && (
        <aside class="reveal space-y-8 self-start rounded-[6px] bg-background-secondary p-7 ring-1 ring-border-secondary ring-inset">
          {goodFit && goodFit.length > 0 && (
            <div>
              <h3 class="eyebrow">A good fit when</h3>
              <ul class="mt-4 space-y-3 text-sm/6">
                {goodFit.map((g) => <li class="flex gap-2.5"><Check className="mt-1 size-4 shrink-0 text-brand-base" aria-hidden="true" />{g}</li>)}
              </ul>
            </div>
          )}
          {notFit && notFit.length > 0 && (
            <div>
              <h3 class="eyebrow">Not the right fit</h3>
              <ul class="mt-4 space-y-3 text-sm/6 text-foreground-secondary">
                {notFit.map((g) => <li class="flex gap-2.5"><Minus className="mt-1 size-4 shrink-0" aria-hidden="true" />{g}</li>)}
              </ul>
            </div>
          )}
          {stack && stack.length > 0 && (
            <div>
              <h3 class="eyebrow">Typical stack</h3>
              <ul class="mt-4 flex flex-wrap gap-2">
                {stack.map((t) => <li class="rounded-full bg-base-default px-3 py-1 font-paper text-xs ring-1 ring-border-secondary ring-inset dark:bg-background-primary">{t}</li>)}
              </ul>
            </div>
          )}
        </aside>
      )
    }
  </div>
</Section>

{
  page.steps.length > 0 && (
    <Section id="process" tone="secondary" eyebrow="How Hiver works" title="A clear sequence," titleMuted="from first conversation to launch.">
      <ol class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {page.steps.map((step, i) => (
          <li class="reveal flex items-start gap-4 rounded-[6px] bg-base-default p-5 shadow-drop-sm ring-1 ring-border-secondary ring-inset dark:bg-background-primary">
            <span class="grid size-7 shrink-0 place-items-center rounded-full bg-brand-8 font-paper text-xs text-brand-base ring-1 ring-brand-20 ring-inset">{i + 1}</span>
            <span class="pt-0.5 text-[15px] font-medium tracking-[-0.2px]">{step}</span>
          </li>
        ))}
      </ol>
    </Section>
  )
}

{page.faqs.length > 0 && <Faq faqs={page.faqs} />}

{
  related.length > 0 && (
    <Section id="related" eyebrow="Related" title="Where to go next.">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((card) => {
          const Icon = card.icon;
          return (
            <article class="reveal group relative flex flex-col rounded-[6px] bg-base-default p-6 shadow-drop-sm ring-1 ring-border-secondary ring-inset transition-shadow duration-200 ease-out-soft hover:shadow-drop-md dark:bg-background-secondary">
              <div class="flex items-center justify-between">
                <span class="grid size-9 place-items-center rounded-[6px] bg-brand-8 text-brand-base ring-1 ring-brand-20 ring-inset">
                  <Icon className="size-4" aria-hidden="true" />
                </span>
                <span class="eyebrow">{card.kind}</span>
              </div>
              <h3 class="mt-6 text-[17px] font-medium tracking-[-0.3px]">
                <a href={card.href} class="after:absolute after:inset-0 after:rounded-[6px]">{card.name}</a>
              </h3>
              <p class="mt-2 flex-1 text-sm/6 text-foreground-secondary">{card.summary}</p>
              <ArrowUpRight className="mt-4 size-4 text-foreground-muted transition-transform duration-200 ease-out-soft group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true" />
            </article>
          );
        })}
      </div>
    </Section>
  )
}

<CtaBand
  title={page.finalCta?.heading ?? primary}
  titleMuted="Start with the problem, not a package."
  body={page.finalCta?.body}
  cta={primary}
/>
