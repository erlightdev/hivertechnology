---
import { ArrowUpRight } from 'lucide-react';
import { formatDate, insightPath, readingMinutes, type Insight } from '@/lib/insights';

export interface Props {
  entry: Insight;
}
const { entry } = Astro.props;
const { data } = entry;
---

<a href={insightPath(entry)} class="reveal group flex h-full flex-col rounded-[6px] bg-base-default shadow-drop-sm ring-1 ring-border-secondary ring-inset dark:bg-background-secondary p-7 transition-shadow duration-200 ease-out-soft hover:shadow-drop-md">
  <div class="flex items-center justify-between">
    <span class="eyebrow">{data.category}</span>
    <ArrowUpRight className="size-4 text-foreground-tertiary transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-foreground-primary" aria-hidden="true" />
  </div>
  <h3 class="mt-6 text-xl font-medium">{data.h1}</h3>
  <p class="mt-3 flex-1 text-sm leading-relaxed text-foreground-tertiary">{data.excerpt}</p>
  <p class="mt-6 text-xs text-foreground-tertiary">
    <time datetime={data.publishDate.toISOString()}>{formatDate(data.publishDate)}</time> · {readingMinutes(entry.body)} min read
  </p>
</a>
