---
import { render } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/common/Breadcrumbs.astro';
import CtaBand from '@/components/common/CtaBand.astro';
import InsightCard from './InsightCard.astro';
import { formatDate, getInsights, insightPath, readingMinutes, type Insight } from '@/lib/insights';
import { article, breadcrumbs, graph } from '@/lib/schema';

export interface Props {
  entry: Insight;
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const path = insightPath(entry);
const { data } = entry;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Insights', path: '/insights/' },
  { name: data.h1, path },
];
const related = (await getInsights()).filter((e) => e.id !== entry.id).slice(0, 2);
const toc = headings.filter((h) => h.depth === 2);
const jsonLd = graph(
  article({
    path,
    title: data.h1,
    description: data.description,
    published: data.publishDate,
    modified: data.updatedDate,
    author: data.author,
  }),
  breadcrumbs(crumbs),
);
---

<BaseLayout title={data.title} description={data.description} {path} indexable={data.indexable} ogType="article" {jsonLd}>
  <article>
    <header class="relative overflow-hidden border-b">
      <div class="bg-dots pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"></div>
      <div class="container-page relative pt-6 pb-12 lg:pt-8">
        <Breadcrumbs items={crumbs} />
        <div class="mt-8 max-w-3xl space-y-4 lg:mt-10">
          <p class="eyebrow">{data.category}</p>
          <h1 class="text-[2rem]/[2.375rem] font-medium tracking-[-1px] lg:text-[2.75rem]/[3rem] lg:tracking-[-1.4px]">{data.h1}</h1>
          <p class="text-lg leading-relaxed text-foreground-tertiary">{data.excerpt}</p>
          <p class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-foreground-tertiary">
            <span>By {data.author}</span>
            {data.reviewer && <span>Reviewed by {data.reviewer}</span>}
            <time datetime={data.publishDate.toISOString()}>{formatDate(data.publishDate)}</time>
            {data.updatedDate && <span>Updated <time datetime={data.updatedDate.toISOString()}>{formatDate(data.updatedDate)}</time></span>}
            <span>{readingMinutes(entry.body)} min read</span>
          </p>
        </div>
      </div>
    </header>

    <div class="container-page grid gap-12 py-14 lg:grid-cols-[1fr_15rem] lg:gap-16">
      <div
        class="prose prose-neutral max-w-none dark:prose-invert prose-headings:font-medium prose-headings:tracking-tight prose-h2:mt-12 prose-a:underline-offset-4 prose-table:text-sm lg:max-w-3xl"
      >
        <Content />
      </div>
      {
        toc.length > 2 && (
          <aside class="hidden lg:block">
            <nav aria-label="On this page" class="sticky top-24 space-y-3 border-l pl-5">
              <p class="eyebrow">On this page</p>
              <ul class="space-y-2 text-sm">
                {toc.map((h) => (
                  <li><a href={`#${h.slug}`} class="text-foreground-tertiary hover:text-foreground-primary">{h.text}</a></li>
                ))}
              </ul>
            </nav>
          </aside>
        )
      }
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="border-t py-16">
        <div class="container-page">
          <h2 class="eyebrow">Keep reading</h2>
          <div class="mt-6 grid gap-4 md:grid-cols-2">
            {related.map((e) => <InsightCard entry={e} />)}
          </div>
        </div>
      </section>
    )
  }
  <CtaBand />
</BaseLayout>
