---
/** Share links for an article. Plain links (no third-party scripts or trackers). */
import { Link2, Mail } from 'lucide-react';
import { absoluteUrl } from '@/config/site';

export interface Props {
  path: string;
  title: string;
}
const { path, title } = Astro.props;
const url = encodeURIComponent(absoluteUrl(path));
const text = encodeURIComponent(title);

const targets = [
  { name: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${url}`, d: 'M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45z' },
  { name: 'WhatsApp', href: `https://wa.me/?text=${text}%20${url}`, d: 'M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48s1.07 2.88 1.21 3.08c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.22 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35zM12.05 21.78h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.82 9.82 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.88 9.88z' },
  { name: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${url}`, d: 'M24 12.07C24 5.41 18.63 0 12 0S0 5.4 0 12.07C0 18.1 4.39 23.1 10.13 24v-8.44H7.08v-3.49h3.04V9.41c0-3.02 1.8-4.7 4.54-4.7 1.31 0 2.68.24 2.68.24v2.97h-1.5c-1.5 0-1.96.93-1.96 1.89v2.26h3.32l-.53 3.5h-2.8V24C19.62 23.1 24 18.1 24 12.07' },
  { name: 'X', href: `https://x.com/intent/post?url=${url}&text=${text}`, d: 'M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.4l-5.8-7.58-6.63 7.58H.48l8.6-9.83L0 1.15h7.59l5.24 6.93 6.07-6.93zm-1.29 19.5h2.04L6.48 3.24H4.3l13.31 17.41z' },
  { name: 'Telegram', href: `https://t.me/share/url?url=${url}&text=${text}`, d: 'M11.94 0A12 12 0 1 0 24 12 12 12 0 0 0 11.94 0zm4.96 7.22c-.16 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 0 0-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z' },
];
const mailto = `mailto:?subject=${text}&body=${url}`;
---

<div class="mt-12 flex flex-wrap items-center gap-2 border-t border-border-line pt-6">
  <span class="eyebrow mr-2">Share</span>
  {
    targets.map((t) => (
      <a
        href={t.href}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Share on ${t.name} (opens in a new tab)`}
        title={t.name}
        class="grid size-9 place-items-center rounded-full bg-background-secondary text-foreground-secondary ring-1 ring-border-secondary ring-inset transition-colors duration-150 hover:text-brand-base"
      >
        <svg viewBox="0 0 24 24" class="size-4" fill="currentColor" aria-hidden="true"><path d={t.d} /></svg>
      </a>
    ))
  }
  <a href={mailto} aria-label="Share by email" title="Email" class="grid size-9 place-items-center rounded-full bg-background-secondary text-foreground-secondary ring-1 ring-border-secondary ring-inset transition-colors duration-150 hover:text-brand-base">
    <Mail className="size-4" aria-hidden="true" />
  </a>
  <button
    type="button"
    data-copy-link={absoluteUrl(path)}
    class="inline-flex h-9 items-center gap-2 rounded-full bg-background-secondary px-3.5 text-[13px] text-foreground-secondary ring-1 ring-border-secondary ring-inset transition-colors duration-150 hover:text-brand-base"
  >
    <Link2 className="size-4" aria-hidden="true" /> <span data-copy-label>Copy link</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((button) => {
    button.addEventListener('click', async () => {
      const label = button.querySelector('[data-copy-label]');
      try {
        if (navigator.share) {
          await navigator.share({ url: button.dataset.copyLink!, title: document.title });
          return;
        }
        await navigator.clipboard.writeText(button.dataset.copyLink!);
        if (label) label.textContent = 'Copied';
      } catch {
        if (label) label.textContent = 'Copy failed';
      }
      setTimeout(() => label && (label.textContent = 'Copy link'), 2000);
    });
  });
</script>
