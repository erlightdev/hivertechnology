---
/** Floating WhatsApp support button (logo from thesvg.org), bottom-right on every page. */
import whatsapp from '@/assets/brand/whatsapp.svg';
import { site } from '@/config/site';

const href = `${site.whatsappHref}?text=${encodeURIComponent('Hi Hiver Technology, I have a question about a project.')}`;
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  aria-label="Chat with us on WhatsApp (opens in a new tab)"
  title="Chat on WhatsApp"
  class="fixed right-4 bottom-4 z-40 grid size-12 place-items-center rounded-full bg-base-default shadow-drop-md ring-1 ring-border-secondary ring-inset transition-transform duration-200 ease-out-soft hover:scale-105 sm:right-6 sm:bottom-6 dark:bg-background-secondary"
>
  <img src={whatsapp.src} alt="" width="26" height="26" class="size-[26px]" />
</a>
