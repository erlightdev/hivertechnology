---
import '@/styles/global.css';
import Seo from '@/components/seo/Seo.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';
import WhatsAppButton from '@/components/layout/WhatsAppButton.astro';
import ConsentBanner from '@/components/layout/ConsentBanner.astro';

export interface Props {
  title: string;
  description: string;
  /** Route path with trailing slash, e.g. "/about-us/". */
  path: string;
  indexable?: boolean;
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  published?: Date;
  modified?: Date;
  author?: string;
}

const { title, description, path, indexable = true, ogType = 'website', jsonLd, published, modified, author } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-pt-20">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo {title} {description} {path} {indexable} {ogType} {jsonLd} {published} {modified} {author} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#fefdfb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0a0b0f" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    <!-- Google Consent Mode v2 & Google Analytics (GA4) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}

      // Establish Google Consent Mode v2 default as 'denied' before any tracking (GDPR compliance)
      gtag('consent', 'default', {
        'analytics_storage': 'denied',
        'ad_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied',
        'wait_for_update': 500
      });

      // Check if user previously gave affirmative consent
      (function() {
        try {
          var stored = localStorage.getItem('hiver_cookie_consent');
          if (stored) {
            var parsed = JSON.parse(stored);
            if (parsed && parsed.analytics) {
              gtag('consent', 'update', {
                'analytics_storage': 'granted',
                'ad_storage': 'denied',
                'ad_user_data': 'denied',
                'ad_personalization': 'denied'
              });
              window._hiverConsentGranted = true;
            }
          }
        } catch (e) {}
      })();

      // Dynamic loader for GA4 - only called on affirmative consent
      function loadGA4() {
        if (window._ga4Initialized) return;
        window._ga4Initialized = true;
        var script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.googletagmanager.com/gtag/js?id=G-TS2KZ7B2PZ';
        document.head.appendChild(script);
        gtag('js', new Date());
        gtag('config', 'G-TS2KZ7B2PZ', {
          anonymize_ip: true,
          cookie_flags: 'SameSite=None;Secure'
        });
      }
      window.hiverLoadGA4 = loadGA4;

      if (window._hiverConsentGranted) {
        loadGA4();
      }
    </script>
    <!-- Apply the stored or system theme before first paint to avoid a flash. -->
    <script is:inline>
      (() => {
        let theme = null;
        try { theme = localStorage.getItem('theme'); } catch {}
        const dark = theme ? theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only z-[100] rounded-md bg-foreground px-4 py-2 text-sm text-background focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
      >Skip to content</a
    >
    <Header currentPath={path} />
    <main id="main" data-rail class="flex-1">
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />
    <ConsentBanner />
    <script>
      import '@/scripts/measurement';
    </script>
    <script>
      // Smooth page scroll (Lenis). Skipped entirely under reduced motion.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        import('lenis').then(({ default: Lenis }) => {
          const lenis = new Lenis({ autoRaf: true, anchors: { offset: -72 } });
          window.addEventListener('hiver:scroll-lock', (event) => {
            if ((event as CustomEvent<boolean>).detail) lenis.stop();
            else lenis.start();
          });
          window.addEventListener('pagehide', () => lenis.destroy(), { once: true });
        });
      }
    </script>
  </body>
</html>
