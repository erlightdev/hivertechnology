# Copy to .env for local testing. In production, set these in Hostinger hPanel
# (Node.js app → Environment variables). Never commit real values.

# SMTP for the contact form. Hostinger Email: smtp.hostinger.com, port 465, SSL.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=website@hiver.com.np
SMTP_PASS=

# Where enquiries are delivered, and the From header (defaults to SMTP_USER).
CONTACT_TO=admin@hiver.com.np
CONTACT_FROM="Hiver Technology Website <website@hiver.com.np>"

# Server (Hostinger usually injects PORT itself).
# PORT=4321
# HOST=0.0.0.0
# CANONICAL_HOST=hiver.com.np
# FORCE_HTTPS=true
